# Application
APP_NAME=Rekha
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-use-a-long-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Atlas
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/rekha?retryWrites=true&w=majority
MONGODB_DB_NAME=rekha

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Cloudinary (optional — for media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Providers (all optional — whiteboard works without them)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Redis (optional — for session caching)
REDIS_URL=redis://localhost:6379

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/svg+xml,application/pdf

# WebSocket
WS_MAX_CONNECTIONS_PER_CLASSROOM=100

